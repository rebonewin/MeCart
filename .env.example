# ---------------------------------------------------------------------------
# MeCart environment template — copy the values into .env.local
# (.env.local is git-ignored; never commit real secrets).
# ---------------------------------------------------------------------------

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin seed account (only used by `npm run seed:admin`)
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# SMS OTP — Twilio Verify (primary provider)
# Account SID + Auth Token: https://console.twilio.com → Account Info
# Verify Service SID: run `npm run twilio:setup` (creates the service and
# prints the VA… SID, 6-digit codes, 5-minute TTL).
# ---------------------------------------------------------------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional — HMAC key for OTP request signing (32+ random characters).
# When unset, a key derived from SUPABASE_SERVICE_ROLE_KEY is used.
OTP_REQUEST_SIGNING_SECRET=

# Optional — E.164 number used by `npm run verify:sms` for one real SMS test.
SMS_TEST_PHONE=

# ---------------------------------------------------------------------------
# Enterprise 2FA
# Recommended: a random 32-byte key (base64 or 64-char hex) used to encrypt
# TOTP secrets with AES-256-GCM. When unset, a key derived from
# SUPABASE_SERVICE_ROLE_KEY is used so local development still works.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
TWO_FACTOR_ENCRYPTION_KEY=

# Optional — separate pepper for recovery-code hashing (HMAC-SHA256).
# When unset, a pepper derived from SUPABASE_SERVICE_ROLE_KEY is used.
TWO_FACTOR_RECOVERY_PEPPER=
