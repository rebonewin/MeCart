# ---------------------------------------------------------------------------
# MeCart environment template — copy the values into .env.local
# (.env.local is git-ignored; never commit real secrets).
# ---------------------------------------------------------------------------

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin seed account (only used by `npm run seed:admin`)
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# SMS OTP — Twilio Verify (primary provider)
# Account SID + Auth Token: https://console.twilio.com → Account Info
# Verify Service SID: run `npm run twilio:setup` (creates the service and
# prints the VA… SID, 6-digit codes, 5-minute TTL).
# ---------------------------------------------------------------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional — HMAC key for OTP request signing (32+ random characters).
# When unset, a key derived from SUPABASE_SERVICE_ROLE_KEY is used.
OTP_REQUEST_SIGNING_SECRET=

# Optional — E.164 number used by `npm run verify:sms` for one real SMS test.
SMS_TEST_PHONE=

# ---------------------------------------------------------------------------
# Enterprise 2FA
# Recommended: a random 32-byte key (base64 or 64-char hex) used to encrypt
# TOTP secrets with AES-256-GCM. When unset, a key derived from
# SUPABASE_SERVICE_ROLE_KEY is used so local development still works.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
TWO_FACTOR_ENCRYPTION_KEY=

# Optional — separate pepper for recovery-code hashing (HMAC-SHA256).
# When unset, a pepper derived from SUPABASE_SERVICE_ROLE_KEY is used.
TWO_FACTOR_RECOVERY_PEPPER=

# ---------------------------------------------------------------------------
# MECO AI concierge — server-side only.
# The key is read exclusively by /api/ai/chat and never sent to the browser.
# Any OpenAI-compatible /chat/completions endpoint works (OpenAI, OpenRouter,
# Azure OpenAI-compatible gateways, Groq, Together, etc.).
# Leave AI_API_KEY empty to run MECO on the built-in on-device assistant.
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional generation limits (clamped to safe ranges by the server).
# AI_MAX_OUTPUT_TOKENS=700
# AI_TEMPERATURE=0.6
# AI_REQUEST_TIMEOUT_MS=60000
# Disable reasoning traces on compatible models (e.g. Ollama qwen3.5).
# AI_REASONING_EFFORT=none

# Optional per-instance abuse guard. Defaults: 20 requests / 5 minutes per
# signed-in shopper and 60 / 5 minutes per IP (higher in development).
# For a globally exact quota, back this with a shared store such as Redis.
# AI_RATE_LIMIT_WINDOW_MS=300000
# AI_RATE_LIMIT_MAX=20
# AI_RATE_LIMIT_IP_MAX=60
# AI_RATE_LIMIT_SALT=
